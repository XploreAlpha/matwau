# MatWAU 学院版 — 环境变量模板(per W37.4)
#
# 用法:
#   cp .env.example .env
#   vi .env   # 改密码 / LLM key / 端口
#   docker compose up -d
#
# ⚠️ .env 文件务必:
#   1. 加入 .gitignore(LICENSE 规定 API key 走 env,不 commit)
#   2. 学院 IT 自己保管(只在 docker host 上可见)
#   3. 定期轮换密码(POSTGRES_PASSWORD)

# ======== 数据库(PostgreSQL)========
# 学院 IT 改密码!
POSTGRES_USER=matwau
POSTGRES_PASSWORD=changeme_in_env_file_2026
POSTGRES_DB=matwau_lineage

# ======== MatWAU 学院版 ========
# 数据归属:学院(写入挂载的 volume,不离开服务器)
MATWAU_DATA_DIR=/srv/matwau/data

# lineage backend:postgres(推荐)/ sqlite(轻量,无需 db container)
MATWAU_LINEAGE_BACKEND=postgres

# ======== LLM 二次复核(可选)========
# 默认 0 = 关闭 LLM,纯 mock 模式(零外部依赖,推荐教学场景)
MATWAU_LLM_ENABLED=0
# 学院 IT 配 LLM 时启用:
# MATWAU_LLM_ENABLED=1
# MATWAU_LLM_API_KEY=sk-xxxxxxxx
MATWAU_LLM_BASE_URL=https://api.deepseek.com
MATWAU_LLM_MODEL=deepseek-v4-flash

# ======== 端口(学院 IT 防火墙可能要求改)========
MATWAU_PORT=8080